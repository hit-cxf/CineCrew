# Local secrets only. Copy to .env, enter provider keys, and generate a local token.
LLM_PROVIDER=openai
LLM_MODEL=qwen3.5-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MAX_RETRIES=2
LLM_TIMEOUT=600
LLM_MAX_COMPLETION_TOKENS=32768
T2I_MODEL=wan2.7-image-pro
T2I_BASE_URL=http://127.0.0.1:8766/v1
T2I_API_KEY=
T2I_SIZE=1024x1024
T2I_KEYFRAME_SIZE=900x1600
VIDEO_MODEL=happyhorse-1.0-i2v
VIDEO_BASE_URL=http://127.0.0.1:8766/v1
VIDEO_API_KEY=
VIDEO_SIZE=720x1280
VIDEO_FPS=30
MEDIA_GATEWAY_TOKEN=
DASHSCOPE_MEDIA_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MEDIA_API_KEY=
TRACE_LOGS=1
